{
  "dashboard": {
    "id": null,
    "uid": null,
    "title": "Team19 IoT Dashboard",
    "tags": [
      "iot",
      "team19"
    ],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": [
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h"
      ],
      "time_options": [
        "5m",
        "15m",
        "1h",
        "6h",
        "12h",
        "24h",
        "2d",
        "7d",
        "30d"
      ]
    },
    "templating": {
      "list": [
        {
          "name": "device",
          "label": "ESP32 Devices",
          "type": "query",
          "datasource": "InfluxDB",
          "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"team19_db\", tag: \"id\", predicate: (r) => true, start: -12h)",
          "refresh": 2,
          "multi": true,
          "includeAll": true,
          "allValue": ".*",
          "hide": 0,
          "sort": 1
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "type": "timeseries",
        "title": "Temperature (\u00b0C)",
        "datasource": "InfluxDB",
        "gridPos": {
          "h": 9,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "refId": "A",
            "query": "from(bucket: \"team19_db\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"temp\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> filter(fn: (r) => contains(value: r.id, set: ${device}))"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            },
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "single"
          }
        }
      },
      {
